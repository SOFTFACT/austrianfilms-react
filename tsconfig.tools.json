{
  // Type-checks what tsconfig.app.json (src) and tsconfig.node.json
  // (vite.config.ts) leave out: the Playwright specs and the test/tool
  // configs. `tsc -b` in the build never sees these files, so a mistyped
  // spec or config option would otherwise fail only at run time.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tools.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["e2e", "playwright.config.ts", "vitest.config.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
