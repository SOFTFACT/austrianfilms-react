{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      // @softfact/react-kit (file:../react-kit) carries its own dev copy of the
      // virtualizer for its tests, and its public types (scrollAdapters) would
      // be checked against that copy -- a different TanStack version is a type
      // error here. Point it at THIS app's copy, the same single copy
      // vite.config.ts dedupes for the bundle.
      "@tanstack/react-virtual": ["./node_modules/@tanstack/react-virtual"]
    }
  },
  "include": ["src"],
  // Unit tests run under Node (process.env.TZ …) and are type-checked by
  // tsconfig.tools.json instead.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
